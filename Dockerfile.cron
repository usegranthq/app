FROM alpine:3.20

RUN apk add --no-cache curl

# Create cron job script
RUN echo '#!/bin/sh' > /usr/local/bin/cron-job.sh && \
    echo 'curl -H "Authorization: Bearer $CRON_SECRET" http://app:3000/api/cron' >> /usr/local/bin/cron-job.sh && \
    chmod +x /usr/local/bin/cron-job.sh

# Create crontab entry
RUN echo '0 */6 * * * /usr/local/bin/cron-job.sh' > /etc/crontabs/root

CMD ["crond", "-f", "-L", "/dev/stdout"]
