datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client"
  output   = "./client"
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  sessions      Session[]
  accounts      Account[]
  apikeys       Apikey[]

  Provider Provider[]
  Tenant   Tenant[]
  Customer Customer?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime
  updatedAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}

model Apikey {
  id                  String    @id
  name                String?
  start               String?
  prefix              String?
  key                 String
  userId              String
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refillInterval      Int?
  refillAmount        Int?
  lastRefillAt        DateTime?
  enabled             Boolean?
  rateLimitEnabled    Boolean?
  rateLimitTimeWindow Int?
  rateLimitMax        Int?
  requestCount        Int?
  remaining           Int?
  lastRequest         DateTime?
  expiresAt           DateTime?
  createdAt           DateTime
  updatedAt           DateTime
  permissions         String?
  metadata            String?

  @@map("apikey")
}

// custom schema below ↓

model Customer {
  id            String @id @default(cuid(2))
  customerRefId String @unique

  userId String @unique
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  Subscription Subscription[]

  @@map("customer")
}

model Subscription {
  id                String   @id @default(cuid(2))
  subscriptionRefId String   @unique
  status            String
  productId         String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  Customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String

  @@map("subscription")
}

model Provider {
  id          String   @id @default(cuid(2))
  name        String
  description String
  urlId       String   @unique
  rotateJwks  Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  Client Client[]
  Domain Domain[]
  Jwks   Jwks[]

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("provider")
}

model Client {
  id        String   @id @default(cuid(2))
  name      String
  audience  String
  subject   String   @default(cuid(2))
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerId String
  Provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("client")
}

model Domain {
  id        String   @id @default(cuid(2))
  domain    String   @unique
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerId String
  Provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("domain")
}

model Jwks {
  id        String   @id @default(cuid(2))
  kid       String
  key       Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerId String
  Provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@map("jwks")
}

model Tenant {
  id          String   @id @default(cuid(2))
  name        String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  TenantProvider TenantProvider[]

  userId String
  User   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tenant")
}

model TenantProvider {
  id                          String   @id @default(cuid(2))
  url                         String
  fingerprints                String[]
  audience                    String
  earliestIssuanceTimeAllowed Int
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  tenantId             String
  Tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  TenantProviderPolicy TenantProviderPolicy[]

  @@unique([url, tenantId])
  @@map("tenant_provider")
}

model TenantProviderPolicy {
  id          String   @id @default(cuid(2))
  name        String
  description String
  audience    String
  conditions  Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantProviderId String
  TenantProvider   TenantProvider @relation(fields: [tenantProviderId], references: [id], onDelete: Cascade)

  @@map("tenant_provider_policy")
}
